[Unit]
Description=Lift Control System (Root Mode)
After=network.target arduino-router.service
Wants=arduino-router.service
StartLimitIntervalSec=0

[Service]
User=root
Group=root
WorkingDirectory=/home/arduino/lift
# รอให้ระบบ Network หรือ Router พร้อมก่อนเริ่ม
ExecStartPre=/usr/bin/sleep 5
# แก้ไข: ชี้ไปที่ python3 ภายใน venv โดยตรง
ExecStart=/home/arduino/lift/venv/bin/python3 /home/arduino/lift/main.py
Restart=always
RestartSec=10

StandardOutput=inherit
StandardError=inherit
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target


