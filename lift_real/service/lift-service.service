[Unit]
Description=Lift Control System
After=network.target arduino-router.service
Wants=arduino-router.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/arduino/lift
ExecStartPre=/usr/bin/sleep 5
ExecStart=/home/arduino/lift/venv/bin/python3 /home/arduino/lift/main.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
